# ==============================================================================
# RollCall AI - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Server Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

# ------------------------------------------------------------------------------
# 2. Database Configuration (Dual-Backend: SQLite & Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Active backend: 'sqlite' (default local development) or 'supabase'
DB_BACKEND=sqlite

# Local SQLite storage
SQLITE_PATH=data/attendance.db
DATABASE_PATH=data/attendance.db
DATA_DIR=data

# Supabase / PostgreSQL URLs
# Standard full database URL:
DATABASE_URL=postgresql://user:password@host:port/dbname
# Read-only database connection URL (for secure queries):
READONLY_DATABASE_URL=postgresql://readonly_user:password@host:port/dbname

# Synchronous connection for Alembic migrations and CLI sync:
DATABASE_URL_SYNC=postgresql+psycopg://user:password@host:5432/postgres?sslmode=require

# Asynchronous connection for FastAPI async sessions (Transaction pooler):
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@host:6543/postgres?ssl=require

# Connection Pool Tunables
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT & RBAC)
# ------------------------------------------------------------------------------
# Local JWT signing secret (minimum 32 characters in production)
JWT_SECRET=
# Legacy or Supabase secret key for HS256 JWT signature verification
JWT_SECRET_KEY=
SUPABASE_JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ALGORITHMS=HS256

# Optional claims validation
JWT_ISSUER=
JWT_AUDIENCE=

# Admin authorization key for sensitive administrative actions (required for ADMIN login)
ADMIN_KEY=

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
# Shared counters (Redis). Leave empty to use the database-backed limiter.
# For local development: `docker compose up -d redis` then uncomment:
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# ------------------------------------------------------------------------------
# 3a. Server-Decided Application Policy (exposed via GET /api/meta/config, N4)
# Values are authoritative; React only displays what the API sends.
# ------------------------------------------------------------------------------
# DEPRECATED (N5): attendance editing is UNLIMITED, so this value never gates
# an edit. It is only kept for API compatibility.
EDIT_LOCK_HOURS=24
# Defaulter: strictly below this attendance percent (N10)
DEFAULTER_THRESHOLD_PERCENT=75.0
# Percent required after attending extra classes (N10)
DEFAULTER_REQUIRED_PERCENT=75.0
# Colour bands for class health (D5): green above BAND_GREEN_ABOVE_PERCENT,
# yellow from BAND_YELLOW_FROM_PERCENT up to and including green boundary, red below
BAND_GREEN_ABOVE_PERCENT=85.0
BAND_YELLOW_FROM_PERCENT=70.0
# Upload limits in bytes (N15)
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_CSV_UPLOAD_BYTES=5242880
# Server-side chat edit confirmation expiry in minutes (D13)
CHAT_CONFIRM_EXPIRY_MINUTES=5
# JWT access token lifetime in minutes (N2)
ACCESS_TOKEN_TTL_MINUTES=15

# ------------------------------------------------------------------------------
# 3c. Security Operations (audit hash chain, security events, detection)
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret for the append-only audit hash chain. Provisioned by the
# database owner OUTSIDE version control (minimum 32 characters). When it is
# absent the chain stays disabled and audit records are reported as
# unverified - they are never claimed to be cryptographically verified.
AUDIT_CHAIN_HMAC_SECRET=
# Optional external anchor for the chain (start of the trusted chain).
AUDIT_CHAIN_GENESIS_ANCHOR=
# Optional file that receives the structured security event log (one JSON per
# line). When empty the events go to the "rollcall.security" logger only.
SECURITY_EVENT_LOG_FILE=
# Honeypot mode: off (default), log or enforce. Decoys are never written to
# the real student, attendance or session tables.
SECURITY_DECOY_MODE=off
# Detection thresholds for the suspicious-activity detectors (all optional).
SEC_FAILED_LOGIN_THRESHOLD=5
SEC_FAILED_LOGIN_WINDOW_SECONDS=900
SEC_ACCESS_DENIED_THRESHOLD=10
SEC_ACCESS_DENIED_WINDOW_SECONDS=600
SEC_STUDENT_ENUMERATION_THRESHOLD=20
SEC_STUDENT_ENUMERATION_WINDOW_SECONDS=300
SEC_FILE_UPLOAD_THRESHOLD=10
SEC_FILE_UPLOAD_WINDOW_SECONDS=600
SEC_FILE_UPLOAD_BYTES_THRESHOLD=50000000
SEC_REFRESH_REUSE_THRESHOLD=1

# ------------------------------------------------------------------------------
# 3b. User Provisioning Seed Variables (backend/scripts/seed_users.py)
# ------------------------------------------------------------------------------
SEED_ADMIN_USER_ID=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

SEED_FACULTY_1_USER_ID=
SEED_FACULTY_1_EMAIL=
SEED_FACULTY_1_PASSWORD=

SEED_FACULTY_2_USER_ID=
SEED_FACULTY_2_EMAIL=
SEED_FACULTY_2_PASSWORD=

SEED_FACULTY_3_USER_ID=
SEED_FACULTY_3_EMAIL=
SEED_FACULTY_3_PASSWORD=


# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web origins. Entries must be exact http(s)
# origins (scheme://host[:port]) with no path, query, fragment, credentials or
# wildcard. Wildcards are ignored for credentialed requests.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Explicit method and request-header allowlists (never '*'). OPTIONS is always added.
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Request-ID,X-CSRF-Token,X-Requested-With,X-RollCall-CSRF

# ------------------------------------------------------------------------------
# 4a. HTTP Security Headers (Person 2, Phase 1)
# ------------------------------------------------------------------------------
# Application-level safety net; the reverse proxy/CDN should set these too.
SECURITY_HEADERS_ENABLED=true
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()
X_FRAME_OPTIONS=DENY
# HSTS is sent only in production or when the request reached the app over HTTPS.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
# Optional full overrides (leave empty to use the built-in API/docs policies).
CONTENT_SECURITY_POLICY=
DOCS_CONTENT_SECURITY_POLICY=

# ------------------------------------------------------------------------------
# 5. Multi-Modal Vision & AI Model Settings
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
PHOTO_LLM_MODEL=gemini-2.0-flash
PHOTO_MIN_CONFIDENCE=0.5
PHOTO_OCR_GPU=0
