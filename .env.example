# ==============================================================================
# RollCall AI - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Server Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

# ------------------------------------------------------------------------------
# 2. Database Configuration (Dual-Backend: SQLite & Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Active backend: 'sqlite' (default local development) or 'supabase'
DB_BACKEND=sqlite

# Local SQLite storage
SQLITE_PATH=data/attendance.db
DATABASE_PATH=data/attendance.db
DATA_DIR=data

# Supabase / PostgreSQL URLs
# Standard full database URL:
DATABASE_URL=postgresql://user:password@host:port/dbname
# Read-only database connection URL (for secure queries):
READONLY_DATABASE_URL=postgresql://readonly_user:password@host:port/dbname

# Synchronous connection for Alembic migrations and CLI sync:
DATABASE_URL_SYNC=postgresql+psycopg://user:password@host:5432/postgres?sslmode=require

# Asynchronous connection for FastAPI async sessions (Transaction pooler):
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@host:6543/postgres?ssl=require

# Connection Pool Tunables
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT & RBAC)
# ------------------------------------------------------------------------------
# Local JWT signing secret (minimum 32 characters in production)
JWT_SECRET=
# Legacy or Supabase secret key for HS256 JWT signature verification
JWT_SECRET_KEY=
SUPABASE_JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ALGORITHMS=HS256

# Optional claims validation
JWT_ISSUER=
JWT_AUDIENCE=

# Admin authorization key for sensitive administrative actions (required for ADMIN login)
ADMIN_KEY=

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600

# ------------------------------------------------------------------------------
# 3a. Server-Decided Application Policy (exposed via GET /api/meta/config, N4)
# Values are authoritative; React only displays what the API sends.
# ------------------------------------------------------------------------------
# Hours after session creation until edits are locked (N5)
EDIT_LOCK_HOURS=24
# Defaulter: strictly below this attendance percent (N10)
DEFAULTER_THRESHOLD_PERCENT=75.0
# Percent required after attending extra classes (N10)
DEFAULTER_REQUIRED_PERCENT=75.0
# Colour bands for class health (D5): green above BAND_GREEN_ABOVE_PERCENT,
# yellow from BAND_YELLOW_FROM_PERCENT up to and including green boundary, red below
BAND_GREEN_ABOVE_PERCENT=85.0
BAND_YELLOW_FROM_PERCENT=70.0
# Upload limits in bytes (N15)
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_CSV_UPLOAD_BYTES=5242880
# Server-side chat edit confirmation expiry in minutes (D13)
CHAT_CONFIRM_EXPIRY_MINUTES=5
# JWT access token lifetime in minutes (N2)
ACCESS_TOKEN_TTL_MINUTES=15

# ------------------------------------------------------------------------------
# 3b. User Provisioning Seed Variables (backend/scripts/seed_users.py)
# ------------------------------------------------------------------------------
SEED_ADMIN_USER_ID=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

SEED_FACULTY_1_USER_ID=
SEED_FACULTY_1_EMAIL=
SEED_FACULTY_1_PASSWORD=

SEED_FACULTY_2_USER_ID=
SEED_FACULTY_2_EMAIL=
SEED_FACULTY_2_PASSWORD=

SEED_FACULTY_3_USER_ID=
SEED_FACULTY_3_EMAIL=
SEED_FACULTY_3_PASSWORD=


# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web origins (wildcards '*' strictly ignored for credentialed requests)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 5. Multi-Modal Vision & AI Model Settings
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
PHOTO_LLM_MODEL=gemini-2.0-flash
PHOTO_MIN_CONFIDENCE=0.5
PHOTO_OCR_GPU=0
