# Existing gitignore content above kept intact

# Environment secrets
.env
.env.*
!.env.example

# SQLite databases
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/
env/

# Frontend dependencies
node_modules/
.next/
out/
build/
dist/

# Database dumps / backups (contain PII and password hashes)
backups/
*.dump
*.sql.gz
*.dump.sha256
postgres_*.sql
postgres_*.sql.zip
attendance_*.db
attendance_*.db.zip

# Temporary files
*.tmp
*.temp
*.bak
*.log
.seed-credentials
*~
.DS_Store
Thumbs.db
backend/.test-tmp/
data/exports/*
!data/exports/.gitkeep
