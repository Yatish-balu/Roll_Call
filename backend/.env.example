# ==============================================================================
# RollCall AI - Backend Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Server Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

# ------------------------------------------------------------------------------
# 2. Database Configuration (Cloud-First: SQLite dev, Supabase production)
# ------------------------------------------------------------------------------
# Supabase is the only supported runtime backend. SQLite requires an explicit
# DB_BACKEND=sqlite and is reserved for isolated tests / emergency tooling.
# DATABASE_URL_SYNC is mandatory whenever DB_BACKEND=supabase.
DB_BACKEND=supabase

# Local SQLite storage (only used when DB_BACKEND=sqlite)
SQLITE_PATH=data/attendance.db
DATABASE_PATH=data/attendance.db
DATA_DIR=data

# Supabase / PostgreSQL URLs
# AUTHORITATIVE WRITE URL for production (used by FastAPI and Alembic):
# Required when APP_ENV=production and DB_BACKEND=supabase.
# Never use READONLY_DATABASE_URL as the write connection.
DATABASE_URL_SYNC=postgresql+psycopg://user:password@host:5432/postgres?sslmode=require

# Legacy Supabase / PostgreSQL URL (secondary; DATABASE_URL_SYNC is authoritative):
DATABASE_URL=postgresql://user:password@host:port/dbname

# Read-only database connection URL (for secure queries only):
# Must not equal DATABASE_URL_SYNC.
READONLY_DATABASE_URL=postgresql://readonly_user:password@host:port/dbname

# Asynchronous connection for Supabase (asyncpg).
# NOTE: Not currently wired into the FastAPI request path (Phase 3 deferred).
# All API routes use synchronous SQLAlchemy sessions.
DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@host:6543/postgres?ssl=require

# SSL requirements:
# - psycopg (sync): sslmode=require (included in DATABASE_URL_SYNC above)
# - asyncpg (async): ssl=require (included in DATABASE_URL_ASYNC above)
# Do not remove SSL parameters when connecting to Supabase.

# Connection Pool Tunables (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT & RBAC)
# ------------------------------------------------------------------------------
# Secret key for HS256 JWT signature verification (minimum 32 characters in production)
JWT_SECRET_KEY=rollcall-dev-secret-key-change-in-production-32bytes-min
SUPABASE_JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ALGORITHMS=HS256

# Optional claims validation
JWT_ISSUER=
JWT_AUDIENCE=

# Admin authorization key for sensitive administrative actions
ADMIN_KEY=your-admin-secret-key

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
# Shared counters (Redis). Leave empty to use the database-backed limiter.
# For local development: `docker compose up -d redis` then uncomment:
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Exact origins only: scheme://host[:port]. No path, query, fragment, credentials
# or wildcard. Wildcards are ignored for credentialed requests.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Request-ID,X-CSRF-Token,X-Requested-With,X-RollCall-CSRF

# ------------------------------------------------------------------------------
# 4a. HTTP Security Headers (Person 2, Phase 1)
# ------------------------------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()
X_FRAME_OPTIONS=DENY
# HSTS is sent only in production or when the request reached the app over HTTPS.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
# Optional full overrides (leave empty to use built-in policies).
CONTENT_SECURITY_POLICY=
DOCS_CONTENT_SECURITY_POLICY=

# ------------------------------------------------------------------------------
# 5. Multi-Modal Vision & AI Model Settings
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
PHOTO_LLM_MODEL=gemini-2.0-flash
PHOTO_MIN_CONFIDENCE=0.5
PHOTO_OCR_GPU=0
