# Application Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

# Data & Database Configuration (Legacy SQLite)
DATABASE_PATH=data/attendance.db
DATA_DIR=data

# ==============================================================================
# PostgreSQL / Supabase Configuration
# ==============================================================================
#
# 1. DATABASE_URL_SYNC:
#    Used for synchronous database tasks: Alembic migrations, one-time data migration
#    scripts, and offline CLI tools.
#    Driver: psycopg v3 ('postgresql+psycopg://...')
#    Connection Mode: Supabase Direct Connection (Session Mode) on Port 5432
#    Example format:
#    DATABASE_URL_SYNC=postgresql+psycopg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# 2. DATABASE_URL_ASYNC:
#    Used for high-concurrency asynchronous runtime: FastAPI backend endpoints.
#    Driver: asyncpg ('postgresql+asyncpg://...')
#    Connection Mode: Supabase Transaction Pooler on Port 6543 (PgBouncer / Supavisor)
#    Example format:
#    DATABASE_URL_ASYNC=postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
#
# Optional Connection Pool Tunables (defaults applied if omitted):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
